# Copy this file to .env for local overrides. Never commit real credentials.
VISION_DOCTOR_LLM__ENABLED=false
VISION_DOCTOR_LLM__PROVIDER=deepseek
VISION_DOCTOR_LLM__MODEL=deepseek-flash
VISION_DOCTOR_LLM__BASE_URL=https://api.deepseek.com
VISION_DOCTOR_LLM__API_KEY=replace-with-deepseek-api-key
VISION_DOCTOR_LLM__TIMEOUT_SECONDS=30
VISION_DOCTOR_LLM__MAX_RETRIES=0
VISION_DOCTOR_LLM__MAX_REPRESENTATIVE_EVIDENCE=5
VISION_DOCTOR_LIVE_API_TEST=0
